{
  "name": "testapp",
  "private": true,
  "scripts": {
    "start": "meteor run",
    "ci": "npm ci && npm run test",
    "setup": "mkdir -p packages && ln -sfn ../../",
    "test": "METEOR_PACKAGE_DIRS='../' TEST_BROWSER_DRIVER=puppeteer meteor test-packages --once --driver-package meteortesting:mocha ../ --port=6776",
    "test:watch": "METEOR_PACKAGE_DIRS='../' TEST_BROWSER_DRIVER=puppeteer TEST_WATCH=1 meteor test-packages --driver-package meteortesting:mocha ../ --port=6776",
    "test:browser": "METEOR_PACKAGE_DIRS='../' TEST_WATCH=1 meteor test-packages --driver-package meteortesting:mocha ../ --port=6776"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.5",
    "meteor-node-stubs": "^1.2.12"
  },
  "devDependencies": {
    "chai": "^6.2.1",
    "puppeteer": "^24.31.0"
  }
}
